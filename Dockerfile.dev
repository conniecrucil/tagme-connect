FROM node:20-alpine

# Install Netlify CLI globally
RUN npm install -g netlify-cli

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy source code
COPY . .

# Expose port 8888 for Netlify dev
EXPOSE 8888

# Start Netlify dev server
CMD ["netlify", "dev", "--port", "8888"]
